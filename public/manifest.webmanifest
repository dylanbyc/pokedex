{
  "name": "Pokédex Scanner",
  "short_name": "Pokédex",
  "description": "Scan Pokémon cards and read their Pokédex entry in 中文 / English / 日本語",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#151a2b",
  "theme_color": "#c8102e",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
